# Editors / IDEs
.vs/
.vscode/
.idea/
*.iml
*.swp
*.swo

# OS junk
*.DS_Store
Thumbs.db
desktop.ini

# Secrets — real per-machine/local overrides only; the checked-in appsettings.json and
# appsettings.Development.json stay tracked since the app needs them to run out of the box.
**/appsettings.*.local.json
