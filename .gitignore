backend/**/*.DotSettings.user

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-error.log*
