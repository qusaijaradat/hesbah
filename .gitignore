# .NET build output
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/*.userosscache
backend/**/*.sln.docstates
backend/**/[Dd]ebug/
backend/**/[Rr]elease/
backend/**/publish/
backend/**/TestResults/
